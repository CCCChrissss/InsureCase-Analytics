# Backend
INSURANCE_CASES_DB_PATH=backend/data/insurance_cases.db
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedding provider settings
# Active providers: local, local_bge
# Remote Hugging Face Inference API implementation has been removed.
# Reserved but not implemented yet: openai, ai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local_hashing_cjk_v1
EMBEDDING_DIMS=384
# Local BGE example (no API token required):
# EMBEDDING_PROVIDER=local_bge
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5-local
# EMBEDDING_DIMS=1024
# LOCAL_BGE_DEVICE=auto
# LOCAL_BGE_BATCH_SIZE=4

# Local case-summary generation (no external inference API or token)
SUMMARY_PROVIDER=ollama_local
SUMMARY_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
SUMMARY_REQUEST_TIMEOUT_SECONDS=240
SUMMARY_NUM_CTX=8192
SUMMARY_MAX_OUTPUT_TOKENS=2048
SUMMARY_SECTION_MAX_CHARS=2000
# Ollama server settings are configured in Windows user environment variables:
# OLLAMA_NO_CLOUD=1
# OLLAMA_MODELS=D:\Models\Ollama

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
